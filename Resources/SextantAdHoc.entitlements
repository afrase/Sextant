<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Ad-hoc builds only (scripts/bundle picks it when SEXTANT_SIGN_IDENTITY is unset). Library validation wants the app and
     the Sparkle.framework it loads signed by the same team, and an ad-hoc signature has no team, so dyld would refuse
     Sparkle. A Developer ID build uses Sextant.entitlements and keeps library validation (ADR 0070). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>
