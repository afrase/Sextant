#!/bin/sh
# Layer rules SwiftPM can't enforce (CLAUDE.md, docs/architecture.md §1): which modules each target may
# import, and which APIs the inner layers may not touch. Our own modules are already checked by Package.swift
# dependencies; this covers system frameworks and Foundation's I/O.
set -eu
cd "$(dirname "$0")/.."
status=0

allow() {  # allow <target> <module...>
    target=$1
    shift
    for file in $(find "Sources/$target" -name '*.swift'); do
        grep -E '^(@testable )?import ' "$file" | sed -E 's/^(@testable )?import ([A-Za-z0-9_]+).*/\2/' | while read -r module; do
            case " $* " in *" $module "*) ;; *) echo "$file: $target may not import $module"; echo x >>"$tmp" ;; esac
        done
    done
}

forbid() {  # forbid <target> <regex> <reason>
    if grep -rnE "$2" "Sources/$1" --include='*.swift' | grep -v '^\s*//'; then
        echo "  ↑ $1: $3"
        echo x >>"$tmp"
    fi
}

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

allow SextantDomain Foundation CoreGraphics
allow SextantApplication Foundation Observation os SextantDomain
allow SextantStorage Foundation CryptoKit os SextantApplication SextantDomain
allow SextantOryx Foundation CryptoKit os SextantApplication SextantDomain
allow SextantBuild Foundation os SextantApplication SextantDomain
allow SextantDevice Foundation IOKit IOUSBHost CryptoKit Carbon Dispatch Synchronization os SextantApplication SextantDomain
allow SextantUI SwiftUI AppKit Foundation Observation Accessibility UniformTypeIdentifiers CoreGraphics os SextantApplication SextantDomain

forbid SextantDomain 'FileManager|URLSession|Data\(contentsOf|\.write\(to|Bundle\.|ProcessInfo|DispatchQueue|Task\.sleep' 'the domain is pure: no I/O, no clocks, no concurrency'
forbid SextantApplication 'FileManager|URLSession|Data\(contentsOf|\.write\(to|Bundle\.main|IOKit|Process\(' 'use cases reach the outside world through ports only'
forbid SextantUI 'SextantStorage|SextantOryx|SextantBuild|SextantDevice|FileManager|URLSession' 'views never touch adapters'

if [ -s "$tmp" ]; then
    echo "Architecture lint failed."
    exit 1
fi
echo "Architecture lint passed."
