#!/bin/sh
# The quality gate (ADR 0018): formatting, lint and layer rules (scripts/lint), a warnings-as-errors build and the tests
# (scripts/test), and an unused-code report. Run from anywhere; run it before every commit. CI runs the two halves as
# separate jobs.
set -eu
cd "$(dirname "$0")/.."

scripts/lint
scripts/test

# shortcut: report-only, so findings never fail the gate; add --strict once the report is clean.
# Not on CI: nobody reads a report there, and .periphery.yml's index store (.build/out) is Swift Build's layout.
if [ -z "${CI:-}" ]; then
    echo "› Periphery (unused code, report only)"
    scripts/periphery || true
fi
