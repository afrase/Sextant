#!/bin/sh
# The quality gate (ADR 0018): formatting, lint and layer rules, a warnings-as-errors build, the tests, and an
# unused-code report. Run from anywhere; run it before every commit.
set -eu
cd "$(dirname "$0")/.."

echo "› swift format (formatting, force-unwrap and force-try bans)"
swift format lint --strict --recursive Sources Tests Package.swift

echo "› SwiftLint (code quality and layer import rules)"
swift package plugin --allow-writing-to-package-directory swiftlint --strict --quiet

echo "› build (warnings are errors)"
swift build --build-tests -Xswiftc -warnings-as-errors

echo "› tests"
swift test --skip-build

echo "› Periphery (unused code, report only)"
# shortcut: report-only while MVP APIs are still being consumed by later slices; add --strict at the end of the MVP.
scripts/periphery || true
