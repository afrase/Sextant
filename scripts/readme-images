#!/bin/sh
# Renders the README's stills offscreen from the snapshot scenes (the author's own layout, dark mode): the layer
# overlay, the menu bar panel and the app icon. Output: docs/images/. The animated tour (tour.webp) is a committed
# asset, not generated here.
set -eu
cd "$(dirname "$0")/.."
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
swift build --product SextantSnapshots >/dev/null
tool="$(swift build --show-bin-path)/SextantSnapshots"

"$tool" "$work" --only hud-symnum-dark,menubar-panel-tiles-dark >/dev/null
sips -Z 1200 "$work/hud-symnum-dark.png" --out docs/images/overlay.png >/dev/null
sips -Z 700 "$work/menubar-panel-tiles-dark.png" --out docs/images/menu-bar.png >/dev/null
sips -s format png -Z 256 Resources/AppIcon.icns --out docs/images/icon.png >/dev/null
echo "docs/images updated"
